/target
/target-linux
/study
/bench/data
/bench/docker/boostsearch
/data

# Intermediate conformance snapshots. The runner writes one per invocation with
# --json-out; only the manifests and the inventory are worth keeping.
/tools/*.json
!/tools/test_inventory.json
!/tools/phase1_manifest.json
!/tools/phase3_manifest.json
!/tools/modules_manifest.json
# what the server Phase 13 replaces scores against its own suite
!/tools/dashboards_baseline.json

# Benchmark output. Keep the Phase 2 progression and the final clean
# head-to-head, which are what the docs report; the rest are working runs.
/bench/results/*.json
!/bench/results/obsearch-baseline.json
!/bench/results/obsearch-sortfix.json
!/bench/results/obsearch-collector.json
!/bench/results/obsearch-mmap.json
!/bench/results/obsearch-bounded.json
!/bench/results/obsearch-topk.json
!/bench/results/obsearch-liveids.json
!/bench/results/obsearch-phase2.json
!/bench/results/final-obs-clean-*.json
!/bench/results/final-os-clean-*.json

# the operating system's and the interpreter's leavings
.DS_Store
__pycache__/
*.pyc

# a build of the old name, kept out of the tree: 14 MB of binary
/bench/docker/obsearch

# the audit's outputs are regenerated by tools/compat_audit.py; the corpus
# it replays (compat-corpus.ndjson) is the input and stays
/compat-inventory.json
/compat-replay.json

# MEMANTO's project-local memory cache: one person's, not the project's
/MEMORY.md

# terraform state for the cloud bench: credentials-adjacent and per-run
/tools/cloud_bench/.terraform/
/tools/cloud_bench/*.tfstate
/tools/cloud_bench/*.tfstate.backup
/tools/cloud_bench/terraform.tfvars

# the editor's own working directories
/.claude/

# working notes from the study phase, written with an AI and not
# reviewed as documents: kept locally, not published
/docs/notes/
