      },
      "service": {
        "type": "keyword"
      },
      "level": {
        "type": "keyword"
      },
      "region": {
        "type": "keyword"
      },
      "host": {
        "type": "keyword"
      },
      "latency_ms": {
        "type": "integer"
      },
