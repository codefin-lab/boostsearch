# Copy to .env and edit. run.sh reads .env if it is there.
#
# Where the server is. `make serve` starts one here.
VS=http://127.0.0.1:9266

# false turns the security plugin ON
VELOSEARCH_DISABLED=false

# which role may use the security REST API
VELOSEARCH_RESTAPI_ROLES_ENABLED=all_access

# the administrator this example configures things as
AUTH=admin:admin
