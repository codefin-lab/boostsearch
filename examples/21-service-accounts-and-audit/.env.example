# Copy to .env and edit. run.sh reads .env if it is there.
#
# Where the server is. `make serve` starts one here.
BS=http://127.0.0.1:9281

# false turns the security plugin ON
BOOSTSEARCH_DISABLED=false

# which role may use the security REST API
BOOSTSEARCH_RESTAPI_ROLES_ENABLED=all_access

# where audit entries go: internal_opensearch (an index on this node, which
# run.sh reads back), log4j or debug (the node's standard error), webhook, or
# external_opensearch. run.sh's last five steps need internal_opensearch.
BOOSTSEARCH_AUDIT_TYPE=internal_opensearch

# the administrator this example configures things as
AUTH=admin:admin

# The machine users' passwords are in run.sh and requests/, and are examples:
#   svc-ingest   ingest-example-passphrase-1, rotated to ingest-rotated-passphrase-4
#   dash-viewer  dashboard-example-passphrase-2, changed to dashboard-rotated-passphrase-3
