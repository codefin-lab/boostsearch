# Copy to .env and edit. run.sh reads .env if it is there.
#
# Where the server is. `make serve` starts one here.
VS=http://127.0.0.1:9267

# where the geoip databases live; see docs/geoip.md in the repository.
# Without them the geoip processor's on_failure sets client.geo.located=false
# and the rest of the example still runs
VELOSEARCH_GEOIP_PATH=/tmp/geoip-db
