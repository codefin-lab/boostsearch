{
  "size": 0,
  "query": {
    "term": {
      "service": "checkout"
    }
  },
  "aggs": {
    "latency": {
      "percentiles": {
        "field": "took_ms",
        "percents": [
          50,
          90,
          95,
          99
        ]
      }
    },
    "under_slo": {
