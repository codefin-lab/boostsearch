# Copy to .env and edit. run.sh reads .env if it is there.
#
# Where the server is. `make serve` starts one here.
BS=http://127.0.0.1:9262

# how often the index-management job runs; the policy in this example is
# written in seconds, so without this the last steps show nothing moving
BOOSTSEARCH_ISM_INTERVAL_MS=2000
