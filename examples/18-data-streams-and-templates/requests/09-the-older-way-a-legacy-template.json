{
  "index_patterns": ["legacy-metrics-*"],
  "order": 1,
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "@timestamp": { "type": "date" },
      "host":       { "type": "keyword" },
      "cpu_pct":    { "type": "float" }
    }
  }
}
