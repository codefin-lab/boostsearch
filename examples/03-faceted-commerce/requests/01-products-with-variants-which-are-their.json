{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "properties": {
      "title": {
        "type": "text",
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "brand": {
        "type": "keyword"
      },
      "colour": {
        "type": "keyword"
      },
      "gender": {
        "type": "keyword"
      },
      "rating": {
        "type": "half_float"
      },
      "tags": {
        "type": "keyword"
      },
      "variants": {
        "type": "nested",
        "properties": {
          "sku": {
            "type": "keyword"
          },
          "size": {
            "type": "keyword"
          },
          "price": {
            "type": "scaled_float",
            "scaling_factor": 100
          },
          "stock": {
            "type": "integer"
          }
        }
      }
    }
  }
}
