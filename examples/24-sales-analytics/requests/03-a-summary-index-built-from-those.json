{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "region": {
        "type": "keyword"
      },
      "category": {
        "type": "keyword"
      },
      "month": {
        "type": "date",
        "format": "strict_date_optional_time||epoch_millis"
      },
      "orders": {
        "type": "long"
      },
      "units": {
        "type": "long"
      },
      "revenue": {
        "type": "double"
      },
      "transform": {
        "properties": {
          "_id": {
            "type": "keyword"
          },
          "_doc_count": {
            "type": "long"
          }
        }
      }
    }
  }
}
