{
  "query": {
    "bool": {
      "filter": [
        {
          "term": {
            "tenant": "acme"
          }
        },
        {
          "term": {
            "status": "open"
          }
        },
        {
          "range": {
            "minutes": {
              "gte": 60
            }
          }
        }
      ]
    }
  },
  "script": {
