# Copy to .env and edit. run.sh reads .env if it is there.
#
# Where the server is. `make serve` starts one here.
VS=http://127.0.0.1:9269

# rule files for the phonetic encoders that need them; see docs/phonetic.md.
# Without them one step reports an error and the rest still runs
VELOSEARCH_PHONETIC_RULES=/tmp/phonetic-rules
